# ----------------------------------------------------------------------
# Landslide EWS backend — environment variables
# Copy this file to .env (or export these when running locally) and
# adjust the values. Every variable listed here is read by the project
# (see config/settings.py). This is a FORMAT TEMPLATE — keep secrets out
# of version control; never commit a real .env.
# ----------------------------------------------------------------------

# --- Django core -------------------------------------------------------------
# Django secret used to sign sessions/cookies and the JWT HMAC key.
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME-IN-PRODUCTION
# Set to "False" in production.
DJANGO_DEBUG=True
# Comma-separated hostnames the backend will serve.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -----------------------------------------------------------------
# NOTE: config/settings.py builds the connection from POSTGRES_* individually;
# a single DATABASE_URL is NOT parsed yet. If you add one, keep POSTGRES_* too.
POSTGRES_DB=landslide_ews
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- CORS (browser origins allowed to call the API) --------------------------
# Comma-separated, no trailing slashes. Vite dev server + a common dev port
# are the defaults. Set explicitly in production (no wildcard support).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Redis / Celery ------------------------------------------------------------
# Broker + result backend for the Celery task queue (ingestion, recompute_risk).
REDIS_URL=redis://localhost:6379/0

# --- JWT ----------------------------------------------------------------------
# Token lifetime in minutes (see apps/users/token_utils.py).
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- SMS gateway (alerts + login OTP) -------------------------------------------
# Login OTP is currently a DEV-ONLY STUB ("000000"/"test-otp"); the SMS gateway
# is mocked until real dispatch is implemented.
SMS_GATEWAY_MOCK=True
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=

# --- FCM (push notifications for alerts) ----------------------------------------
# Path to a Firebase service-account credentials JSON.
FCM_CREDENTIALS_PATH=

# --- S3 / MinIO (report photo/video uploads) -------------------------------------
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=landslide-reports

# --- Ingestion client API keys ---------------------------------------------------
# None of the ingestion clients (IMD, SMAP, GSI, OSM, LULC, DEM) currently read
# API keys from the environment — all sources are public endpoints. If any starts
# requiring credentials, add the key as its own variable here and read it in the
# client (e.g. IMD_API_KEY, NASA_EARTHDATA_TOKEN).